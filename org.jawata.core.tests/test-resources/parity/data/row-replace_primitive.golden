=== ReplacePrimitiveTargets.java ===
package com.example;

/**
 * Row 54 (Replace Primitive with Object) fixtures — the canonical case and each shape refused.
 *
 * <p>A new file in EXISTING packages, deliberately, and a second one beside it
 * ({@code ReplacePrimitiveUser}) for the cross-file case — the shape
 * {@code MoveFieldSource}/{@code MoveFieldUser} already established here. Adding a PACKAGE to
 * this shared sample project once took it over the minimum sample {@code AnalyzeNamingToolTest}
 * relies on and turned that test red; the rule earned there is that a fixture must not move a
 * census some other test measures. Method bodies are distinct for the same reason on the clone
 * axis, which Stage 6 met from the other direction.</p>
 */
public class ReplacePrimitiveTargets {

    /** THE CANONICAL CASE: a String that has started to mean something, read and written. */
    public static class Order {
        private String priority;

        public Order(String priority) {
            this.priority = priority;
        }

        public String describe() {
            return "order at " + priority;
        }

        public boolean isUrgent() {
            return "high".equals(priority);
        }

        public void escalate() {
            priority = "high";
        }
    }

    /** THE CROSS-FILE CASE: a public field {@code ReplacePrimitiveUser} reads and writes. */
    public static class Shipment {
        public Carrier carrier = new Carrier("unassigned");

        public String label() {
            return "via " + carrier.value();
        }

        /**
         * The String Shipment used to hold bare, now a type of its own.
         * Generated by Replace Primitive with Object (Fowler row 54); give it the behaviour
         * that was written at every site holding the String.
         */
        public record Carrier(String value) {
        }
    }

    /**
     * A write whose VALUE reads the same field — {@code total = total + n}.
     *
     * <p>Not a refusal: it is a plain assignment, and upstream's circuit breaker writes
     * exactly this shape. It is here because the read sits INSIDE the value being wrapped,
     * which is the one place the two rewrites have to agree.</p>
     */
    public static class Tally {
        private int total;

        public void add(int amount) {
            total = total + amount;
        }

        public int shown() {
            return total;
        }
    }

    /** REFUSAL — static final: a constant may stand where only a constant may. */
    public static class Limits {
        public static final int MAX_ITEMS = 50;

        public int clamp(int requested) {
            return requested > MAX_ITEMS ? MAX_ITEMS : requested;
        }
    }

    /** REFUSAL — changed in place, so there is no single right rewrite. */
    public static class Counter {
        private int hits;

        public void record() {
            hits += 1;
        }

        public int total() {
            return hits;
        }
    }

    /** REFUSAL — a shared declaration; retyping one fragment means splitting the line. */
    public static class Box {
        private int width, height;

        public Box(int width, int height) {
            this.width = width;
            this.height = height;
        }

        public int area() {
            return width * height;
        }
    }

    /** REFUSAL — the declaring type already declares the name the default would generate. */
    public static class Ticket {
        private String severity;

        public Ticket(String severity) {
            this.severity = severity;
        }

        public String show() {
            return "ticket " + severity;
        }

        /** Exactly what {@code severity} capitalises to, so the default name is taken. */
        public static class Severity {
        }
    }

    /** REFUSAL — already an object; there is no primitive to replace. */
    public static class Basket {
        private java.util.List<String> items = new java.util.ArrayList<>();

        public int count() {
            return items.size();
        }
    }
}
=== ReplacePrimitiveUser.java ===
package com.example;

import com.example.ReplacePrimitiveTargets.Shipment;

/**
 * The OTHER file — what makes row 54's cross-file claim checkable rather than asserted.
 *
 * <p>It reads and writes a field of Shipment from outside the declaring file, so a run that
 * only rewrote the declaration would leave this reading a record where a String is expected.
 * That is the half replace_type_code_with_class says in its own description it does not do.</p>
 *
 * <p><b>Nothing in this file quotes the expected OUTPUT, and that is deliberate.</b> The first
 * version of it did, in these comments — and the test asserting the migration then passed on
 * the comment rather than on the code, which the parity golden caught by disagreeing with a
 * green test. A fixture must not contain the string its own test searches for.</p>
 */
public class ReplacePrimitiveUser {

    /** A read from another file. */
    public String manifestFor(Shipment shipment) {
        return "manifest: " + shipment.carrier.value();
    }

    /** A write from another file. */
    public void reassign(Shipment shipment, String name) {
        shipment.carrier = new Shipment.Carrier(name);
    }
}
