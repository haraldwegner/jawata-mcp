=== CommandTargets.java ===
package com.example;

/**
 * Fixtures for Fowler row 41, Replace Command with Function, as
 * {@code change_method_signature kind=replace_command_with_function}.
 *
 * <p>The shape is a class whose whole job is one method, built and run in the same expression. The
 * refusals are the ones the fork census made the priority: a method a supertype declares (27 of
 * its 33 candidates), a field the constructor computes, a field written afterwards, several
 * methods, and a use that HOLDS the command instead of running it.</p>
 *
 * <p>These are nested classes on purpose — one file, so a reader can see the whole set, and the
 * lookup has to descend into member types, which two earlier stages of this sprint found it
 * failing to do.</p>
 */
public class CommandTargets {

    /** The shape: two fields, one constructor that only assigns them, one method. */
    public static class Discount {

        public static double execute(double base, int rate, int rounding) {
            return Math.round((base * (100 - rate) / 100.0) * rounding) / (double) rounding;
        }
    }

    /** REFUSED: a supertype declares it, so the caller chose this one by constructing it. */
    public static class Loud implements Speaker {

        private final String words;

        public Loud(String words) {
            this.words = words;
        }

        @Override
        public String say() {
            return words.toUpperCase(java.util.Locale.ROOT);
        }
    }

    /** The supertype that makes {@link Loud} a dispatch rather than a waste. */
    public interface Speaker {

        String say();
    }

    /** REFUSED: the constructor COMPUTES a field rather than taking it. */
    public static class Computed {

        private final double total;

        public Computed(double base, double tax) {
            this.total = base + tax;
        }

        public double execute() {
            return total;
        }
    }

    /** REFUSED: a field is written after construction, so the object carries state over time. */
    public static class Accumulating {

        private int count;

        public Accumulating(int count) {
            this.count = count;
        }

        public int execute() {
            count = count + 1;
            return count;
        }
    }

    /** REFUSED: two instance methods, so which one the function is would be a choice. */
    public static class TwoJobs {

        private final int value;

        public TwoJobs(int value) {
            this.value = value;
        }

        public int execute() {
            return value;
        }

        public int twice() {
            return value * 2;
        }
    }

    /** REFUSED at its use site: something HOLDS it, which is what a command is for. */
    public static class Held {

        private final int value;

        public Held(int value) {
            this.value = value;
        }

        public int execute() {
            return value;
        }
    }
}
=== CommandDesk.java ===
package com.example;

/**
 * Uses of {@link CommandTargets}' commands in ANOTHER FILE — built and run in one expression,
 * except the one that is deliberately held.
 */
public class CommandDesk {

    /** Builds and runs in one expression, which is the shape this row can rewrite. */
    public double discounted(double base) {
        return CommandTargets.Discount.execute(base, 10, 100);
    }

    /** A SECOND use, because a rewrite that reached one is not evidence it reaches all. */
    public double alsoDiscounted(double base) {
        return CommandTargets.Discount.execute(base, 25, 10);
    }

    /** Chooses an implementation by constructing it — the dispatch the refusal protects. */
    public String loudly(String words) {
        CommandTargets.Speaker speaker = new CommandTargets.Loud(words);
        return speaker.say();
    }

    /** Runs the computed-field case, so it has a use and refuses for the constructor instead. */
    public double computed(double base, double tax) {
        return new CommandTargets.Computed(base, tax).execute();
    }

    /** Runs the accumulating case, so it refuses for the field written afterwards. */
    public int accumulated(int start) {
        return new CommandTargets.Accumulating(start).execute();
    }

    /** Runs the two-method case, so it refuses for having two jobs. */
    public int twoJobs(int value) {
        return new CommandTargets.TwoJobs(value).execute();
    }

    /** HOLDS the command and runs it later, which is exactly what a command is for. */
    public int held(int value) {
        CommandTargets.Held command = new CommandTargets.Held(value);
        return command.execute();
    }
}
