=== FlagArgumentTargets.java ===
package com.example;

/**
 * Fixtures for Fowler row 35, Remove Flag Argument, as
 * {@code change_method_signature kind=remove_flag_argument}.
 *
 * <p>The shape is a boolean parameter that selects behaviour and that every caller passes as a
 * literal. The refusals are a caller passing a variable, a non-boolean parameter, a name the class
 * already declares, and a method nobody calls.</p>
 *
 * <p>No comment here quotes what the operation emits and none spells a declaration a test anchors
 * on.</p>
 */
public class FlagArgumentTargets {

    /** Fowler's own shape: the literal at the call is the whole decision. */
    public double price(double base, boolean premium) {
        return premium ? base * 1.5 : base;
    }

    /** price with the flag set to true: generated by Remove Flag Argument (Fowler row 35). */
    public double atPremium(double base) {
        return price(base, true);
    }

    /** price with the flag set to false: generated by Remove Flag Argument (Fowler row 35). */
    public double atStandard(double base) {
        return price(base, false);
    }

    /** One of its callers passes a variable, so that caller has no name to become. */
    public double fare(double base, boolean express) {
        return express ? base + 10 : base;
    }

    /** Its flag is not a boolean, which is outside this row's scope. */
    public double tiered(double base, int tier) {
        return base * tier;
    }

    /** The class already declares something a chosen name would collide with. */
    public double levied(double base, boolean exempt) {
        return exempt ? base : base * 1.2;
    }

    /** The collision {@link #levied} runs into — same arity, so the generated one would not fit. */
    public double untaxed(double base) {
        return base;
    }

    /**
     * Every caller passes the SAME literal, so one generated method would have no caller.
     *
     * <p>The FORK is what put this case here: all fourteen of its methods declaring a boolean
     * parameter are called with one value and only one, so the row would have generated dead code
     * on every candidate the corpus offers.</p>
     */
    public double always(double base, boolean rounded) {
        return rounded ? Math.round(base) : base;
    }

    /** Nobody calls it, so the two named methods would be generated for nobody. */
    public double uncalled(double base, boolean doubled) {
        return doubled ? base * 2 : base;
    }
}
=== FlagArgumentDesk.java ===
package com.example;

/**
 * Callers of {@link FlagArgumentTargets} in ANOTHER FILE, carrying both literals and the variable
 * that makes one method unfoldable.
 */
public class FlagArgumentDesk {

    private final FlagArgumentTargets targets = new FlagArgumentTargets();

    /** Passes the flag one way… */
    public double premium(double base) {
        return targets.atPremium(base);
    }

    /** …and its neighbour passes it the other, so both named methods get a caller. */
    public double regular(double base) {
        return targets.atStandard(base);
    }

    /** A second caller of the same side, so the rewrite must reach more than one. */
    public double alsoPremium(double base) {
        return targets.atPremium(base);
    }

    /** Decides at the call, which this row can rewrite. */
    public double expressFare(double base) {
        return targets.fare(base, true);
    }

    /** Passes the decision ON, which is the case with no name to become. */
    public double eitherFare(double base, boolean chosen) {
        return targets.fare(base, chosen);
    }

    /** Passes the flag one way… */
    public double roundedOnce(double base) {
        return targets.always(base, true);
    }

    /** …and so does its neighbour, which is what makes the flag one-sided. */
    public double roundedTwice(double base) {
        return targets.always(base, true);
    }

    /** Calls the non-boolean case, so it has callers and refuses for the type instead. */
    public double tiered(double base) {
        return targets.tiered(base, 3);
    }

    /** Calls the case whose chosen name would collide with an existing method. */
    public double levied(double base) {
        return targets.levied(base, false);
    }
}
