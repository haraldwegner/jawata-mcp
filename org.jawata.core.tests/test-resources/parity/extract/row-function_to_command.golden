=== Scoring.java ===
package com.example;

/** Row 48 (Sprint 28d-rescue): a static function worth turning into a command. */
public class Scoring {

    public int instanceScore(int base) {
        return base + 1;
    }
}
=== ScoreCommand.java ===
package com.example;

/**
 * score, as a command: its parameters are fields, its body is execute().
 *
 * <p>Generated by Replace Function with Command (Fowler). The point of the shape is that
 * the body can now be broken into named steps that share the fields, which was not
 * possible while they were parameters.</p>
 */
public class ScoreCommand {

    private final int base;
    private final int bonus;

    public ScoreCommand(int base, int bonus) {
        this.base = base;
        this.bonus = bonus;
    }

    public int execute() {
        int weighted = base * 3;
        int total = weighted + bonus;
        return total;
    }
}
=== ScoringCaller.java ===
package com.example;

/** Two call sites, so the command rewrite has references to move. */
public class ScoringCaller {

    public int plain() {
        return new ScoreCommand(10, 2).execute();
    }

    public int shifted(int bonus) {
        return new ScoreCommand(20, bonus).execute();
    }
}
