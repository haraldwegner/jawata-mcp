=== ReadingFunctions.java ===
package com.example;

/**
 * Two static functions that both take a Reading first, and one that does not — the third is
 * what proves the grouping is checked rather than assumed.
 */
public class ReadingFunctions {

    public static int unrelated(int plain) {
        return plain + 1;
    }
}
=== ReadingCharge.java ===
package com.example;

/**
 * The data these functions were all passing to each other, with the functions on it.
 *
 * <p>Generated by Combine Functions into Class (Fowler); the grouping was the caller's
 * decision.</p>
 */
public class ReadingCharge {

    private final Reading reading;

    public ReadingCharge(Reading reading) {
        this.reading = reading;
    }

    public int baseCharge()     {
      return reading.quantity() * 2;
    }

    public int taxThreshold(int allowance)     {
      return reading.quantity() - allowance;
    }
}
=== ReadingCaller.java ===
package com.example;

/** Calls both functions the old way, so the combine has call sites to rewrite. */
public class ReadingCaller {

    public int charge(Reading reading) {
        return new ReadingCharge(reading).baseCharge();
    }

    public int taxable(Reading reading) {
        return new ReadingCharge(reading).taxThreshold(5);
    }
}
