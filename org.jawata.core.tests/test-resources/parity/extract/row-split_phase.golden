=== TwoPhase.java ===
package com.example;

/** Row 64 (Sprint 28d-rescue): one function doing two jobs in sequence, and two it cannot. */
public class TwoPhase {

    public int priceOrder(int quantity, int unitPrice) {
        PriceOrderIntermediate intermediate = priceOrderPhase1(quantity, unitPrice);
        return priceOrderPhase2(intermediate);
    }

    public int earlyExit(int quantity) {
        int base = quantity * 2;
        if (base > 100) {
            return 0;
        }
        return base + 1;
    }

    public int writesBack(int quantity) {
        int base = quantity * 2;
        base = base + 5;
        return base;
    }

    /** What the first phase hands the second. Generated by Split Phase. */
    private record PriceOrderIntermediate(int base, int discountLevel) {}

    private PriceOrderIntermediate priceOrderPhase1(int quantity, int unitPrice) {
        int base = quantity * unitPrice;
        int discountLevel = quantity / 500;
        int unused = quantity + 1;
        return new PriceOrderIntermediate(base, discountLevel);
    }

    private int priceOrderPhase2(PriceOrderIntermediate intermediate) {
        int base = intermediate.base();
        int discountLevel = intermediate.discountLevel();
        int discount = discountLevel * 100;
        return base - discount;
    }
}
