=== MiddleManPerson.java ===
package com.example;

/**
 * Two pure forwarders and one method that transforms — the third must survive, because
 * deleting it would change what callers get.
 */
public class MiddleManPerson {

    private final Department department = new Department("Ada");

    public String shoutedManager() {
        return department.manager().toUpperCase();
    }

    /** The delegate, now reached directly. Generated by Remove Middle Man. */
    public Department department() {
        return department;
    }
}
=== MiddleManCaller.java ===
package com.example;

/** Reaches the department through the middle man, which is what row 36 undoes. */
public class MiddleManCaller {

    public String who(MiddleManPerson person) {
        return person.department().manager();
    }

    public int howMany(MiddleManPerson person) {
        return person.department().headcount();
    }
}
