<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sprint 28d-rescue Stage 4 — a fixture project holding a VERBATIM slice of the
  pinned upstream fork, for the per-row clause that every row must be demonstrated
  "on code we did not author": a fixture written for the test does not satisfy it.

  Deliberately SEPARATE from simple-maven, for the reason fork-circuit-breaker
  records: that fixture feeds roughly forty smell detectors whose counts are
  asserted elsewhere, and foreign code dropped into it shifts those baselines for
  a reason unrelated to what they measure.

  No dependencies on purpose, which for THIS slice is a stated cost rather than a
  free choice: upstream's sources import lombok and slf4j, so those imports do not
  resolve here. That is accepted precedent (fork-step-builder does the same) and it
  is harmless for what this slice pins, because the row REFUSES before it builds any
  change — nothing here ever reaches the compile gate.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jawata.fixtures</groupId>
    <artifactId>fork-lockable-object</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
