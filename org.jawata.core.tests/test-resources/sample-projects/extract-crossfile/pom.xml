<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sprint 28d Stage 8 — the fixture for Extract Class ACROSS A FILE BOUNDARY.

  Why it exists: Extract Class was proven to move a field cluster and rewrite the
  accesses WITHIN the declaring file. Both existing fixtures make the cross-file
  case structurally impossible, not merely untested — their fields are PRIVATE, and
  a private field cannot be read from another file at all. So no test could have
  covered the case, and none did.

  The shape here is the one real code has and the one most likely to break: a
  PACKAGE-PRIVATE field cluster read directly from a second file in the same
  package. Moving those fields without following their readers leaves the second
  file referring to state that is no longer there.

  Deliberately SEPARATE from simple-maven, for the reason factory-target is: that
  fixture feeds roughly forty smell detectors whose counts are asserted elsewhere,
  and adding types to it would shift baselines for a reason unrelated to what they
  measure.

  No dependencies on purpose: it compiles against the JDK alone, so nothing here
  can fail for a resolution reason and be mistaken for a refactoring defect.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jawata.fixtures</groupId>
    <artifactId>extract-crossfile</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
