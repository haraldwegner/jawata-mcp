<?xml version="1.0" encoding="UTF-8"?>
<!-- Sprint 28 D-IMPORTER fixture: a PLAIN Eclipse project (.classpath, no
     MANIFEST.MF, no pom) — the only declared build system with no sample.
     The test="true" attribute on the second entry is Eclipse's own way of
     saying "this root is test code", and is what Stage 2 tags from. -->
<classpath>
    <classpathentry kind="src" path="src/main/java"/>
    <classpathentry kind="src" path="src/test/java" test="true"/>
    <classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
    <!-- The declared dependency. lib/example-lib.jar holds com.example.libs.EclipseLib,
         so the test can assert the entry was HONOURED (the type resolves) rather
         than merely parsed. -->
    <classpathentry kind="lib" path="lib/example-lib.jar"/>
    <classpathentry kind="output" path="bin"/>
</classpath>
