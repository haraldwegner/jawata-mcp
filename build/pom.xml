<?xml version="1.0" encoding="UTF-8"?>
<!-- Sprint 22d SPIKE: plain-Maven build of jawata against Maven-Central Eclipse
     bundles + programmatic Equinox boot (the jdt.ls pattern). Branch-only —
     never part of the Tycho reactor. Version pins = the 2026-06 train as
     published on Central (verified 2026-07-12, dossier-22d.md). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jawata</groupId>
    <artifactId>org.jawata.build</artifactId>
    <version>4.4.14</version>
    <packaging>pom</packaging>

    <modules>
        <!-- First: it depends on nothing, and mcp depends on it. -->
        <module>catalogue</module>
        <module>core</module>
        <module>mcp</module>
        <module>boot</module>
        <module>testrunner</module>
        <module>pitplugin</module>
        <module>tests-core</module>
        <module>tests-mcp</module>
        <!-- 28d: the cure specimens. Built so their addresses cannot rot;
             deliberately absent from dist, which the enforcer proves. -->
        <module>samples</module>
        <module>dist</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 2026-06 train on Maven Central (repo1 metadata, 2026-07-12) -->
        <v.jdt.core>3.46.0</v.jdt.core>
        <v.jdt.launching>3.24.200</v.jdt.launching>
        <v.jdt.manipulation>1.24.100</v.jdt.manipulation>
        <v.jdt.junit.core>3.14.200</v.jdt.junit.core>
        <v.jdt.junit.runtime>3.8.100</v.jdt.junit.runtime>
        <v.jdt.junit5.runtime>1.2.100</v.jdt.junit5.runtime>
        <v.ltk>3.15.200</v.ltk>
        <v.core.runtime>3.34.200</v.core.runtime>
        <v.core.resources>3.24.0</v.core.resources>
        <v.core.filesystem>1.11.400</v.core.filesystem>
        <v.core.jobs>3.15.800</v.core.jobs>
        <v.core.contenttype>3.9.800</v.core.contenttype>
        <v.core.expressions>3.9.600</v.core.expressions>
        <v.osgi>3.24.200</v.osgi>
        <v.osgi.services>3.12.300</v.osgi.services>
        <v.osgi.util>3.7.400</v.osgi.util>
        <v.text>3.14.700</v.text>
        <v.jface.text>3.31.0</v.jface.text>
        <v.equinox.common>3.20.400</v.equinox.common>
        <v.equinox.preferences>3.12.100</v.equinox.preferences>
        <v.equinox.registry>3.12.600</v.equinox.registry>
        <v.equinox.app>1.7.600</v.equinox.app>
        <v.felix.scr>2.2.18</v.felix.scr>
        <v.debug.core>3.23.300</v.debug.core>

        <!-- third-party (same pins as the Tycho target) -->
        <v.jackson>2.19.0</v.jackson>
        <v.h2>2.2.224</v.h2>
        <v.slf4j>2.0.18</v.slf4j>

        <!-- S16-1: where the error-stub guard below looks. Each module's own output by default;
             build/stub-class-guard-test.sh points it at a scratch folder, so the guard's own
             rule is what the self-test drives, not a copy of it. -->
        <stub.scan.dir>${project.build.directory}</stub.scan.dir>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- S16-1: NEVER PACKAGE A CLASS THAT DOES NOT COMPILE.

                 An editor that imports these modules as Maven projects (VS Code's Java
                 language server does) compiles into the SAME target/classes as this build,
                 with the Eclipse compiler, and on code that does not compile it writes an
                 error-stub class whose every entry point throws "Unresolved compilation
                 problem". Its class is then NEWER than the source, so maven-compiler-plugin
                 answers "Nothing to compile - all classes are up to date" and this build
                 packages the stub: BUILD SUCCESS, exit 0, no ERROR line - measured
                 2026-10-15 over a source with a syntax error; the stub was written 0.6 s
                 after the edit. Every gate that judged a build by its exit status was blind
                 to it, and the failure surfaced only at run time.

                 So the build reads its own output for the marker every such stub carries,
                 whoever compiled it, and refuses. Bound to process-test-classes so that
                 -DskipTests, which skips running tests and not compiling them, still runs it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>refuse-error-stub-classes</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <fileset id="stubs" dir="${stub.scan.dir}"
                                         includes="classes/**/*.class,test-classes/**/*.class"
                                         erroronmissingdir="false">
                                    <contains text="Unresolved compilation problem"/>
                                </fileset>
                                <pathconvert refid="stubs" property="stub.list"
                                             pathsep="${line.separator}  "/>
                                <fail message="Error-stub class(es) in ${stub.scan.dir} - code that does not compile, written there by another compiler (an editor's Java language server shares this output folder), would be packaged as if it built:${line.separator}  ${stub.list}${line.separator}Fix the source, or delete the class and rebuild.">
                                    <condition>
                                        <resourcecount refid="stubs" when="greater" count="0"/>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
