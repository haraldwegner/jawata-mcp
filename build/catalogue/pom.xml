<?xml version="1.0" encoding="UTF-8"?>
<!-- Sprint 28g (D39, architecture P2 step 3): org.jawata.catalogue — the shared
     catalogue of refactorings and smells, as production code no engine owns.

     IT DECLARES NO DEPENDENCIES, AND THAT IS THE DELIVERABLE. Every other bundle
     here lists JDT, Eclipse or Jackson; this one lists nothing, so the purity
     property is enforced by the build itself before any test runs — a reference
     to an engine type would not compile. The checked-in MANIFEST says the same
     thing a second way: it has no Import-Package at all, so OSGi would refuse
     such a reference at resolve time too. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jawata</groupId>
        <artifactId>org.jawata.build</artifactId>
        <version>4.4.14</version>
    </parent>

    <artifactId>org.jawata.catalogue</artifactId>

    <build>
        <sourceDirectory>${project.basedir}/../../org.jawata.catalogue/src</sourceDirectory>
        <!-- THE PATTERN LANE'S ROWS ARE A RESOURCE, and without this block they are silently
             absent from the jar. `sourceDirectory` is overridden above, which does NOT bring
             resources with it: Maven's default resource root is src/main/resources, which this
             layout does not have. So the resource root has to be named.

             IT IS A ROOT OF ITS OWN, NOT `src` WITH THE SOURCES EXCLUDED, which is what this
             block declared until 2026-10-07. Maven accepts a resource root equal to the source
             root and builds correctly from it; AN ECLIPSE BUILD PATH CANNOT HOLD TWO SOURCE
             FOLDERS AT ONE LOCATION. So m2e could not configure this module, an editor driven
             by it saw a project contributing no types, and every org.jawata.catalogue reference
             read as unresolved — while this build, which never consults a build path, stayed
             green and said nothing. Of the nine modules here it was the only one with that
             overlap and the only one an editor could not resolve. org.jawata.mcp already keeps
             its resources in a root of their own; this follows it, and the rows keep their
             classpath location, so Patterns loads exactly what it loaded before.

             `Patterns` throws rather than returning an empty list when the resource is missing,
             because a lane that reads as empty makes every count taken against it pass by
             agreeing with nothing. The two halves are deliberate: this block is what SHIPS the
             file, and that throw is what makes a build which stops shipping it loud. -->
        <resources>
            <resource>
                <directory>${project.basedir}/../../org.jawata.catalogue/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestFile>${project.basedir}/../../org.jawata.catalogue/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
