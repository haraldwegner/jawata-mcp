<?xml version="1.0" encoding="UTF-8"?>
<!-- 22d spike: org.jawata.mcp compiled by PLAIN MAVEN from the existing source
     tree. Keeps the checked-in OSGi MANIFEST + plugin.xml (the application
     extension the app launcher resolves). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jawata</groupId>
        <artifactId>org.jawata.build</artifactId>
        <version>4.6.17</version>
    </parent>

    <artifactId>org.jawata.mcp</artifactId>

    <properties>
        <!-- 28h z-step 12: the seat files sealed in the engine are generated from jawata-studio at the commit named in
             build/seats.ref; the engine repository holds no copy. A checkout elsewhere is named with -Djawata.studio=<folder>. -->
        <jawata.studio>${project.basedir}/../../../jawata-studio</jawata.studio>
    </properties>

    <dependencies>
        <dependency><groupId>org.jawata</groupId><artifactId>org.jawata.catalogue</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.jawata</groupId><artifactId>org.jawata.core</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.jawata</groupId><artifactId>org.jawata.spi</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.eclipse.jdt</groupId><artifactId>org.eclipse.jdt.core.manipulation</artifactId><version>${v.jdt.manipulation}</version></dependency>
        <!-- Sprint 23: jdt.junit.core + debug.core deps dropped with the JDT-LTK
             launch path; jdt.launching stays (runner classpath resolution) and
             brings debug.core transitively for compile. -->
        <dependency><groupId>org.eclipse.jdt</groupId><artifactId>org.eclipse.jdt.launching</artifactId><version>${v.jdt.launching}</version></dependency>
        <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.text</artifactId><version>${v.text}</version></dependency>
        <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.jface.text</artifactId><version>${v.jface.text}</version></dependency>
        <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.ltk.core.refactoring</artifactId><version>${v.ltk}</version></dependency>
        <dependency><groupId>org.jacoco</groupId><artifactId>org.jacoco.core</artifactId><version>0.8.15</version></dependency>
        <dependency><groupId>org.jacoco</groupId><artifactId>org.jacoco.report</artifactId><version>0.8.15</version></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><version>${v.h2}</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${v.jackson}</version></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>${v.slf4j}</version></dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/../../org.jawata.mcp/src</sourceDirectory>
        <resources>
            <!-- Sprint 27 D1: the owned embedder's bundled resources (WordPiece
                 vocabulary now; model weights at Stage 2). They land at the jar
                 root so the tokenizer reads /embed/vocab.txt off its own
                 classloader - the PRODUCT never fetches anything. -->
            <resource>
                <directory>${project.basedir}/../../org.jawata.mcp/resources</directory>
            </resource>
            <!-- The generated seats, at /seats in the bundle (written by the generate-seats step below). -->
            <resource>
                <directory>${project.build.directory}/generated-seats</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-seats</id>
                        <phase>generate-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <fail message="No jawata-studio checkout at ${jawata.studio}: the engine's seat files are generated from it. Check it out beside this repository, or name it with -Djawata.studio=&lt;folder&gt;.">
                                    <condition><not><available file="${jawata.studio}/seats" type="dir"/></not></condition>
                                </fail>
                                <loadfile property="seats.ref" srcFile="${project.basedir}/../seats.ref">
                                    <filterchain><striplinebreaks/></filterchain>
                                </loadfile>
                                <delete dir="${project.build.directory}/generated-seats"/>
                                <delete dir="${project.build.outputDirectory}/seats"/>
                                <mkdir dir="${project.build.directory}"/>
                                <exec executable="git" dir="${jawata.studio}" failonerror="true">
                                    <arg value="-c"/>
                                    <arg value="core.autocrlf=false"/>
                                    <arg value="archive"/>
                                    <arg value="--format=zip"/>
                                    <arg value="-o"/>
                                    <arg file="${project.build.directory}/seats.zip"/>
                                    <arg value="${seats.ref}"/>
                                    <arg value="seats"/>
                                </exec>
                                <unzip src="${project.build.directory}/seats.zip" dest="${project.build.directory}/generated-seats"/>
                                <!-- A pin that holds no seat file must not build an engine without seats. -->
                                <fail message="jawata-studio ${seats.ref} holds no seats/*.md, so the engine would be built without seats.">
                                    <condition><not><resourcecount count="0" when="greater"><fileset dir="${project.build.directory}/generated-seats" includes="seats/*.md" erroronmissingdir="false"/></resourcecount></not></condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Sprint 27 D1: VectorApiMatMul references the incubating
                         Vector API, so it must be on the module path to COMPILE.
                         Runtime is separate and optional: MatMuls loads it
                         reflectively, so a JVM launched without the flag simply
                         runs the scalar backend. -->
                    <compilerArgs>
                        <arg>--add-modules</arg><arg>jdk.incubator.vector</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestFile>${project.basedir}/../../org.jawata.mcp/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
