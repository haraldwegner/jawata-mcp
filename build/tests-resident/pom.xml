<?xml version="1.0" encoding="UTF-8"?>
<!-- 28k Stage 7: org.jawata.resident.tests compiled verbatim as an OSGi FRAGMENT of
     org.jawata.resident — test classes share the host's classloader, so a test in an
     org.jawata.resident package reaches that package's package-private members and the
     platform-bound tests run against the real booted workspace. The sample projects stay
     in org.jawata.core.tests/test-resources; the tests find them by the fixtures property. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jawata</groupId>
        <artifactId>org.jawata.build</artifactId>
        <version>4.4.15</version>
    </parent>

    <artifactId>org.jawata.resident.tests</artifactId>

    <dependencies>
        <dependency><groupId>org.jawata</groupId><artifactId>org.jawata.core</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.jawata</groupId><artifactId>org.jawata.resident</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version></dependency>
        <dependency>
            <groupId>org.gradle</groupId><artifactId>gradle-tooling-api</artifactId><version>8.10</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../../org.jawata.resident/lib/gradle-tooling-api-8.10.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/../../org.jawata.resident.tests/src</sourceDirectory>
        <plugins>
            <!-- 28k Stage 8: the abstract port contracts and the fake host live in the mcp test sources (org.jawata.mcp.contract), where
                 the engine's own tests use them. The headless host's ports run the same contracts, so the one folder is compiled into
                 this fragment too; a class carries no source folder, only its package, and the model sees both as one project. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-contracts</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${project.basedir}/../../org.jawata.mcp.tests/src/org/jawata/mcp/contract</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Only the shareable half is compiled here: the concrete tests of the engine's own bundle stay where they are. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/FakeHostPortsContractTest.java</exclude>
                        <exclude>**/StandInLanguageContractTest.java</exclude>
                        <exclude>**/JavaLanguageContractTest.java</exclude>
                        <exclude>**/PurityControl.java</exclude>
                        <exclude>**/PurityScanTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive><manifestFile>${project.basedir}/META-INF/MANIFEST.MF</manifestFile></archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
